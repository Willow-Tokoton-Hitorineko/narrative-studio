{
  "name": "narrative-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Chinese writing desk with author-approved AI drafting.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "studio:build": "pnpm --filter @narrative-studio/studio build",
    "studio:typecheck": "tsc -p apps/studio/tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && pnpm studio:build && vitest run",
    "demo": "node scripts/demo.mjs",
    "cli": "node apps/cli/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "iconv-lite": "0.7.3",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
