{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativestudio.local/schema/snapshot-manifest.v1.json",
  "title": "SnapshotManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "kind",
    "project_id",
    "created_at",
    "source_revision",
    "app_version",
    "file_count",
    "digest",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snap_[a-z0-9]{8,40}$"
    },
    "kind": {
      "enum": [
        "backup",
        "export"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-z0-9]{8,32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rel_path",
          "sha256",
          "size"
        ],
        "properties": {
          "rel_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
