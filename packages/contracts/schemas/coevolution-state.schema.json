{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativestudio.local/schema/coevolution-state.v1.json",
  "title": "CoevolutionState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "version",
    "updated_at",
    "consent",
    "observations",
    "policies",
    "goals",
    "reflections",
    "exercises"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-z0-9]{8,32}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reflections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
