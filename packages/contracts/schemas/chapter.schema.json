{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativestudio.local/schema/chapter.v1.json",
  "title": "Chapter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chapter_id",
    "project_id",
    "volume_id",
    "title",
    "ordinal",
    "current_revision_id",
    "content_hash",
    "word_count",
    "created_at",
    "updated_at",
    "provenance",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch_[a-z0-9]{8,40}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-z0-9]{8,32}$"
    },
    "volume_id": {
      "type": "string",
      "pattern": "^vol_[a-z0-9]{6,32}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "current_revision_id": {
      "type": "string",
      "pattern": "^rev_[0-9]{8}_[0-9a-f]{12}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "status": {
      "enum": [
        "draft",
        "committed"
      ]
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "actor_id"
      ],
      "properties": {
        "source": {
          "enum": [
            "author",
            "import",
            "model",
            "system",
            "migration"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    }
  }
}
