{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativestudio.local/schema/project.v1.json",
  "title": "Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "description",
    "language",
    "default_volume_id",
    "created_at",
    "updated_at",
    "status",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-z0-9]{8,32}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "default_volume_id": {
      "type": "string",
      "pattern": "^vol_[a-z0-9]{6,32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "actor_id"
      ],
      "properties": {
        "source": {
          "enum": [
            "author",
            "import",
            "model",
            "system",
            "migration"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    }
  }
}
