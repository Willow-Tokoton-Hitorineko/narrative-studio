{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativestudio.local/schema/import-metadata.v1.json",
  "title": "ImportMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "import_id",
    "project_id",
    "created_at",
    "source_filename",
    "source_sha256",
    "source_bytes",
    "source_encoding",
    "line_ending",
    "chapter_count",
    "volume_count",
    "empty_chapter_count",
    "raw_path",
    "provenance",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "import_id": {
      "type": "string",
      "pattern": "^imp_[a-z0-9]{8,40}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-z0-9]{8,32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "source_encoding": {
      "enum": [
        "utf-8",
        "utf-8-bom",
        "gb18030",
        "utf-16le",
        "utf-16be"
      ]
    },
    "line_ending": {
      "enum": [
        "lf",
        "crlf",
        "mixed",
        "none"
      ]
    },
    "chapter_count": {
      "type": "integer",
      "minimum": 1
    },
    "volume_count": {
      "type": "integer",
      "minimum": 1
    },
    "empty_chapter_count": {
      "type": "integer",
      "minimum": 0
    },
    "raw_path": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "status": {
      "enum": [
        "committed"
      ]
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "actor_id"
      ],
      "properties": {
        "source": {
          "enum": [
            "author",
            "import",
            "model",
            "system",
            "migration"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    }
  }
}
