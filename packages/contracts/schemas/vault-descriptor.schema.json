{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativestudio.local/schema/vault-descriptor.v1.json",
  "title": "VaultDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vault_id",
    "kind",
    "created_at",
    "app_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "vault_id": {
      "type": "string",
      "pattern": "^vlt_[a-z0-9]{8,32}$"
    },
    "kind": {
      "const": "narrative-studio-vault"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    }
  }
}
