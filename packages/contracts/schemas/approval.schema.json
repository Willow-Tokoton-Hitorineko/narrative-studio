{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativestudio.local/schema/approval.v1.json",
  "title": "Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "project_id",
    "created_at",
    "actor",
    "action",
    "scope",
    "decision",
    "note",
    "provenance",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "approval_id": {
      "type": "string",
      "pattern": "^apr_[0-9]{8}_[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-z0-9]{8,32}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "action": {
      "enum": [
        "commit_chapter",
        "commit_canon",
        "approve_style_constitution",
        "restore_backup"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "type": "string",
          "pattern": "^ch_[a-z0-9]{8,40}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^rev_[0-9]{8}_[0-9a-f]{12}$"
        },
        "proposal_id": {
          "type": "string",
          "pattern": "^prop_[a-z0-9]{8,40}$"
        }
      }
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ]
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "actor_id"
      ],
      "properties": {
        "source": {
          "enum": [
            "author",
            "import",
            "model",
            "system",
            "migration"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "author",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
