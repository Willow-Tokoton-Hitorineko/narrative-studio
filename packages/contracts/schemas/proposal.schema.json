{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativestudio.local/schema/proposal.v1.json",
  "title": "Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "project_id",
    "chapter_id",
    "base_revision",
    "content_hash",
    "body_path",
    "created_at",
    "origin",
    "status",
    "note",
    "provenance",
    "decided_at",
    "decided_by"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^prop_[a-z0-9]{8,40}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-z0-9]{8,32}$"
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^ch_[a-z0-9]{8,40}$"
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "body_path": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "origin": {
      "enum": [
        "author",
        "import",
        "model",
        "system"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "stale"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "decided_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/actor"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "actor_id"
      ],
      "properties": {
        "source": {
          "enum": [
            "author",
            "import",
            "model",
            "system",
            "migration"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tool": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "author",
            "agent",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
